# 환경변수 예시 — 이 파일을 .env 로 복사하고 값만 채우세요.
# ⚠️ 실제 값이 든 .env 파일은 절대 깃허브에 올리지 마세요 (.gitignore에 .env 추가).

# 어드민 비밀번호 (하드코딩 대신 여기서 관리, 없으면 앱이 거부하도록)
ADMIN_PW=

# 외부 API 키 (예시 — 쓰는 서비스에 맞게)
# 키가 없으면 mock-fallback.ts로 예시 데이터가 나오게 해두면 개발이 편합니다.
NAVER_API_KEY=

# 구글 애널리틱스 측정 ID (G-XXXXXXXXXX) — 클라이언트 노출되어도 되는 값
NEXT_PUBLIC_GA_ID=
